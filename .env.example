NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (server-only service role — never expose to the browser)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Founder inbox + transactional email (Resend)
FOUNDER_EMAIL=you@example.com
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Meridian <onboarding@resend.dev>

# Optional analytics (privacy-conscious; only fires after cookie consent)
# Plausible site domain, e.g. meridian.example
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional server webhook for first-party events (no secrets in the browser)
ANALYTICS_WEBHOOK_URL=
