NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (server-only service role — never expose to the browser / never use NEXT_PUBLIC_)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Optional: anon key only for local RLS verification scripts (not used by the Next.js app)
# SUPABASE_ANON_KEY=your_anon_key

# Founder inbox + transactional email (Resend)
FOUNDER_EMAIL=you@example.com
RESEND_API_KEY=re_xxxxxxxx
# Development may use Resend test sender; production MUST use a verified Meridian domain address
RESEND_FROM_EMAIL=Meridian <onboarding@resend.dev>

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Upstash Redis (serverless rate limiting for /api/leads)
UPSTASH_REDIS_REST_URL=https://YOUR_UPSTASH_REDIS.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# One-way salt for hashing client IPs used only as rate-limit keys (never store raw IPs)
LEAD_IP_HASH_SALT=replace_with_long_random_string

# Newsletter (promotional; double opt-in). Postal address required for marketing footers (CAN-SPAM style).
NEWSLETTER_POSTAL_ADDRESS=Meridian, [street], [city], [postcode], [country]

# Optional analytics (privacy-conscious; only fires after cookie consent)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
ANALYTICS_WEBHOOK_URL=
